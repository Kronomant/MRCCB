{
  "name": "gestao-obra-piedade",
  "version": "1.4.1",
  "description": "Sistema de Gestão de Reuniões da Obra da Piedade - Congregação Cristã no Brasil",
  "author": "example.com",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck": "tsc --noEmit",
    "dev:vite": "vite",
    "build:vite": "vite build",
    "dev": "tauri dev",
    "build": "tauri build && node scripts/copy-setup.mjs",
    "tauri": "tauri",
    "pwa:dev": "vite --config src/pwa/vite.config.ts",
    "pwa:build": "vite build --config src/pwa/vite.config.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:atendimento": "ts-node ./src/tests/atendimentoProntuarioNumber.test.ts",
    "version": "node scripts/sync-version.mjs && git add src-tauri/tauri.conf.json src-tauri/Cargo.toml src-tauri/Cargo.lock"
  },
  "dependencies": {
    "@ark-ui/react": "^5.36.0",
    "@chakra-ui/react": "^3.21.0",
    "@emotion/react": "^11.14.0",
    "@hookform/resolvers": "^5.2.2",
    "@react-pdf/renderer": "^4.3.2",
    "@tanstack/react-query": "^5.74.4",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "chart.js": "^4.5.1",
    "date-fns": "^4.1.0",
    "driver.js": "^1.4.0",
    "next-themes": "^0.4.6",
    "phosphor-react": "^1.4.1",
    "qrcode.react": "^4.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-hook-form": "^7.61.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.5.1",
    "sass": "^1.86.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.7.0",
    "@rocketseat/eslint-config": "^2.2.2",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.23.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.23",
    "jsdom": "^27.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.16"
  }
